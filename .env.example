# =====================================================================
# CONFIGURATION INSTRUCTIONS:
# ---------------------------------------------------------------------
# - Agent Mode: When deploying the project in Agent mode, you only 
#   need to set the first 4 variables (incluido ZBX_METADATA con el rol).
# - Server Mode: When deploying in Server mode, all variables must be 
#   set, except for those marked as DO NOT EVER CHANGE.
# =====================================================================
#----- Remote agent FQDN ---------
AGENT_FQDN=databus.siua.ac.cr
#----- Remote agent hostname ---------
REMOTE_AGENT_HOSTNAME=Databus-host
#----- Red Docker de la aplicación a la que se une el agente remoto ---------
#      R3 (databus): databus_internal      R2 (infobus): infobus_internal
#      Confirmar con: docker inspect <contenedor orchestrator> --format '{{json .NetworkSettings.Networks}}'
AGENT_DOCKER_NETWORK=databus_internal
#----- Contraseña de PostgreSQL para el ítem pgsql.bloat.detail (psql) ---------
AGENT_PGPASSWORD=postgres
SERVER_FQDN=r4.siua.ac.cr
#----- Metadata de autorregistro: "docker-autoreg" + rol del servidor ---------
#      Servidor R4 (modo server):  docker-autoreg
#      R3 (modo agent, databus):   docker-autoreg databus
#      R2 (modo agent, infobus):   docker-autoreg infobus
#      El rol decide qué plantillas recibe el agente al autorregistrarse.
ZBX_METADATA=docker-autoreg


#---- Zabbix API and WEB user credentials -----
API_WEB_USER=tfg
API_WEB_PASS=tf6_2026
#----- Internal database password---------
POSTGRES_PASSWORD=%zabbix_bucr_2025%


# =====================================================================
# DO NOT EVER CHANGE
# ---------------------------------------------------------------------
# - DOCKER_GID is set by wazuh-dev.sh script, dont touch !!!
# - 'LOCAL_AGENT_HOSTNAME=localhost' is used to set a real hostname to 
#   the agents !!!
# =====================================================================
TZ=America/Costa_Rica
PHP_TZ=America/Costa_Rica
ZBX_DB_IP=zabbix-postgres-bd
ZBX_SERVER_IP=zabbix-server-pgsql
SCRIPT_POST_INSTALL=scripts/zabbix-conf-en.sh
DEFAULT_USER=Admin
DEFAULT_PASS=zabbix
LOCAL_HOST_NAME=Zabbix-server
HOST_DNS=zabbix-agent2
HOST_PORT=10050
HOST_GROUP=Monitoring hosting
#----- Zabbix server API endpoint -------
API_URL=http://zabbix-dashboard:8080/api_jsonrpc.php
#--------- Never use extensions in the sudoers file name, "." are not allowed ---------------------
AGENT_SUDOERS_FILE=simovilab-sudoers
#---------- Dashboard ----------
PORT_HTTP=8080
PORT_HTTPS=8443
#---------- Database -----------
POSTGRES_USER=zabbix
POSTGRES_DB=zabbix

#----- Plantillas (solo modo server; en modo agent no se leen).
#      Archivos separados por COMA, nombres por BARRA VERTICAL, mismo orden.
#      El separador de nombres no puede ser coma: los nombres de plantilla
#      de Zabbix la contienen.
#
#      LOCAL_*         -> host local de R4 (contenedor zabbix-agent2 del servidor)
#      ROLE_DATABUS_*  -> agentes con ZBX_METADATA "docker-autoreg databus" (R3)
#      ROLE_INFOBUS_*  -> agentes con ZBX_METADATA "docker-autoreg infobus" (R2)
#      simovilab-infobus-ext: medición externa de infobus desde R4 (por Traefik) y resta con la interna de R2
LOCAL_TEMPLATE_FILES=simovilab-templates.yml,simovilab-infobus-ext.yml
LOCAL_TEMPLATE_NAMES=simovilab servidor y sistema operativo|simovilab-infobus-ext

ROLE_DATABUS_TEMPLATE_FILES=simovilab-templates.yml,simovilab-databus.yml
ROLE_DATABUS_TEMPLATE_NAMES=simovilab servidor y sistema operativo|simovilab-databus

ROLE_INFOBUS_TEMPLATE_FILES=simovilab-templates.yml,simovilab-infobus.yml
ROLE_INFOBUS_TEMPLATE_NAMES=simovilab servidor y sistema operativo|simovilab-infobus

#---------- zabbix-remote-Agent2 -----------
ZBX_PORTS=10050:10050
ZBX_ACTIVE_ALLOW=true
ZBX_REFRESH_ACTIVE_CHECKS=60
#ZBX_HOSTNAME=Zabbix server
ZBX_TLSCONNECT=psk                             # ← activo usa PSK
ZBX_TLSACCEPT=psk                              # ← pasivo usa PSK
ZBX_TLSPSKIDENTITY=zabbix-databus-psk          # ← nombre identificador
ZBX_TLSPSKFILE=/etc/zabbix/zabbix_agentd.psk   # ← ruta del archivo en el docker del Agent2
ZBX_TLSPSKFILENAME=zabbix_agentd.psk           # ← ruta del archivo en el host que aloja al Agent2
ZBX_AGENT_CONFIG_FILE=zabbix_agent2.conf
ZBX_AGENT_DEFAULT_SCRIPTS_DIR=/var/lib/zabbix/user_scripts

############################
# Item creation parameters #
#    ItemKey:ScriptName    #
############################
# - You can add for example "AGENT_PARAM_TCP=net.stats:tcp-net-json.sh" pairs here, and they will be created automatically 
#   by the zabbix-dev.sh script. 
# - The variable name must be in the format AGENT_PARAMS_XX, where XX is a alpha-numeric string, we recommend less than 5 characters.

AGENT_PARAMS_00=host.tcp.established:zabbix-host-tcp-established.sh

#--------- Server --------------
#ZBX_SERVER_HOST=zabbix-server-pgsql
#ZBX_SERVER_PORT=10051
ZBX_ENABLE_SNMP_TRAPS=true

#----- Time Zone ------

#------ Metadata for autoregistration ------

