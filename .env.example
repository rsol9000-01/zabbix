#VARIABLES FOR NETWORK CONFIGURATION net0
#SUBNET=10.50.50.0/24
#GATEWAY=10.50.50.1
#ZBX_DB_IP=10.50.50.2
##############################################
# Remote Agent: These variables are required #
##############################################

################################
# These variables are required #
################################
#---- Zabbix API and WEB user credentials -----
API_WEB_USER=tfg
API_WEB_PASS=tf6_2026

#----- Zabbix server FQDN ---------
SERVER_FQDN=r4.siua.ac.cr

#----- Remote agent FQDN ---------
AGENT_FQDN=databus.siua.ac.cr

#----- Remote agent hostname ---------
REMOTE_AGENT_HOSTNAME=Databus host

#----- Zabbix server API endpoint -------
API_URL=http://r4.siua.ac.cr:8080/api_jsonrpc.php

#----- Internal database password---------
POSTGRES_PASSWORD=%zabbix_bucr_2025%

#----- Time Zone ------
TZ=America/Costa_Rica
PHP_TZ=America/Costa_Rica

#------ Metadata for autoregistration ------
ZBX_METADATA=docker-autoreg

################################
# These variables are optional #
################################

#---------- Services ----------
ZBX_DB_IP=zabbix-postgres-bd
#ZBX_SERVER_IP=10.50.50.3
ZBX_SERVER_IP=zabbix-server-pgsql
#ZBX_TRAPS_IP=10.50.50.4
#ZBX_TRAPS_IP=zabbix-snmptraps
#ZBX_DASHBOARD_IP=10.50.50.5
#ZBX_DASHBOARD_IP=zabbix-dashboard
#ZBX_AGENT2_IP=10.50.50.6
#ZBX_AGENT2_IP=zabbix-agent2

#---------- Dashboard ----------
PORT_HTTP=8080
PORT_HTTPS=8443

#---------- Database -----------
POSTGRES_USER=zabbix
POSTGRES_DB=zabbix
#DB_SERVER_HOST=zabbix-postgres-bd

#--------- Server --------------
#ZBX_SERVER_HOST=zabbix-server-pgsql
#ZBX_SERVER_PORT=10051
ZBX_ENABLE_SNMP_TRAPS=true

#---------- zabbix-init service -----------
SCRIPT_POST_INSTALL={script/zabbix-conf-en.sh}
DEFAULT_USER=Admin
DEFAULT_PASS=zabbix
HOST_NAME=Zabbix server
HOST_DNS=zabbix-agent2        # service name in compose = internal DNS
HOST_PORT=10050
HOST_GROUP=Monitoring hosting
#HOST_TEMPLATE=Linux by Zabbix agent, Docker by Zabbix agent 2, Zabbix server health
HOST_TEMPLATE=Linux by Zabbix agent

#---------- zabbix-remote-Agent2 -----------
ZBX_PORTS=10050:10050
ZBX_ACTIVE_ALLOW=true
ZBX_REFRESH_ACTIVE_CHECKS=60
#ZBX_HOSTNAME=Zabbix server
ZBX_TLSCONNECT=psk                             # ← activo usa PSK
ZBX_TLSACCEPT=psk                              # ← pasivo usa PSK
ZBX_TLSPSKIDENTITY=zabbix-databus-psk           # ← nombre identificador
ZBX_TLSPSKFILE=/etc/zabbix/zabbix_agentd.psk    # ← ruta del archivo en el ocker del Agent2

