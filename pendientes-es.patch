diff --git a/scripts/zabbix-conf-es.sh b/scripts/zabbix-conf-es.sh
new file mode 100755
index 0000000..3e6faeb
--- /dev/null
+++ b/scripts/zabbix-conf-es.sh
@@ -0,0 +1,791 @@
+#!/usr/bin/env bash
+# ---------------------------------------------------------------------------
+# Configurar Zabbix después de la instalación mediante el servicio zabbix-init
+# ---------------------------------------------------------------------------
+# ---------------------------------------------------------------------------
+# Definir los colores usados en los mensajes del script
+# ---------------------------------------------------------------------------
+ORANGE='\033[38;2;252;209;161m'
+RED='\033[0;31m'
+GREEN='\033[0;32m'
+YELLOW='\033[1;33m'
+BLUE='\033[0;34m'
+CYAN='\033[0;36m'
+GRAY='\033[0;90m'
+NC='\033[0m'
+# ---------------------------------------------------------------------------
+# Detener la ejecución ante errores o variables sin definir
+# ---------------------------------------------------------------------------
+set -eu
+# ---------------------------------------------------------------------------
+# Inicializar la bandera para crear el usuario web con las credenciales del .env
+# TRUE indica que el inicio de sesión usó las credenciales por defecto.
+# ---------------------------------------------------------------------------
+flag_new_user=FALSE
+
+# ---------------------------------------------------------------------------
+# Leer del archivo montado la PSK que usa el autorregistro de Zabbix
+# ---------------------------------------------------------------------------
+PSK_VALUE=$(cat /${ZBX_TLSPSKFILENAME})
+
+# ---------------------------------------------------------------------------
+# Quitar espacios al inicio y al final sin depender de utilidades externas
+# ---------------------------------------------------------------------------
+trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }
+
+# ---------------------------------------------------------------------------
+# Rechazar variables de configuración que ya no se admiten
+# ---------------------------------------------------------------------------
+if [ -n "${AGENT_TEMPLATE_FILE:-}${AGENT_TEMPLATE_FILES:-}" ]; then
+  echo "❌ ERROR: AGENT_TEMPLATE_FILE(S) / AGENT_TEMPLATE_NAME(S) ya no se usan."
+  echo "   Usar LOCAL_TEMPLATE_*, ROLE_DATABUS_TEMPLATE_* y ROLE_INFOBUS_TEMPLATE_* (ver .env.example)."
+  exit 1
+fi
+# ---------------------------------------------------------------------------
+# Esperar a que responda la API de Zabbix
+# ---------------------------------------------------------------------------
+echo "⏳ Esperando a que la API de Zabbix esté disponible..."
+MAX_RETRIES=10      
+COUNT=0
+
+until curl -sf -o /dev/null -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -d '{"jsonrpc":"2.0","method":"apiinfo.version","params":{},"id":1}'; do
+  
+  COUNT=$((COUNT + 1))
+  
+  if [ "$COUNT" -ge "$MAX_RETRIES" ]; then
+    echo "❌ La API no responde después de $MAX_RETRIES intentos, saliendo..."
+    exit 1
+  fi
+  
+  echo "⏳ Intento $COUNT/$MAX_RETRIES — se reintenta en 5 segundos..."
+  sleep 5
+done
+
+echo "✅ API disponible"
+
+# ---------------------------------------------------------------------------
+# Autenticarse y obtener el token de acceso
+# ---------------------------------------------------------------------------
+# ---------------------------------------------------------------------------
+# Intentar autenticarse con las credenciales por defecto
+# ---------------------------------------------------------------------------
+echo "🔒 Autenticando con el usuario por defecto..."
+TOKEN=$(curl -sf -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -d "{\"jsonrpc\":\"2.0\",\"method\":\"user.login\",\"params\":{\"username\":\"$DEFAULT_USER\",\"password\":\"$DEFAULT_PASS\"},\"id\":1}" \
+  | grep -o '"result":"[^"]*"' | cut -d'"' -f4)
+
+# ---------------------------------------------------------------------------
+# Usar las credenciales del .env si falla la autenticación por defecto
+# ---------------------------------------------------------------------------
+if [ -z "$TOKEN" ]; then
+  echo "⚠️  Falló la autenticación con el usuario por defecto, se intenta con el usuario '$API_WEB_USER' del .env..."
+  TOKEN=$(curl -sf -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"user.login\",\"params\":{\"username\":\"$API_WEB_USER\",\"password\":\"$API_WEB_PASS\"},\"id\":1}" \
+    | grep -o '"result":"[^"]*"' | cut -d'"' -f4)
+
+  if [ -z "$TOKEN" ]; then
+    echo "❌ No se pudo autenticar con ningún usuario, saliendo..."
+    exit 1
+  fi
+  echo "   - 🔑 Autenticado con el usuario del .env: $API_WEB_USER"
+else
+  echo "   - 🔑 Autenticado con el usuario por defecto: $DEFAULT_USER"
+  flag_new_user=TRUE
+fi
+echo "   - 🔑 Token obtenido"
+
+# ---------------------------------------------------------------------------
+# Obtener el grupo de hosts configurado o crearlo si no existe
+# ---------------------------------------------------------------------------
+
+GROUP_ID=$(curl -s -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -H "Authorization: Bearer $TOKEN" \
+  -d "{\"jsonrpc\":\"2.0\",\"method\":\"hostgroup.get\",\"params\":{\"filter\":{\"name\":[\"$HOST_GROUP\"]},\"output\":[\"groupid\"]},\"id\":1}" \
+  | grep -o '"groupid":"[^"]*"' | head -1 | cut -d'"' -f4)
+
+if [ -z "$GROUP_ID" ]; then
+  echo "📁 Creando el grupo: $HOST_GROUP"
+  GROUP_ID=$(curl -sf -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"hostgroup.create\",\"params\":{\"name\":\"$HOST_GROUP\"},\"id\":3}" \
+    | grep -o '"groupids":\["[^"]*"' | cut -d'"' -f4)
+else
+  echo "📁 El grupo \"$HOST_GROUP\" ya existe."
+fi
+echo "   - 📁 Grupo: '$HOST_GROUP' ID: $GROUP_ID"
+
+# ---------------------------------------------------------------------------
+# Importar o buscar las plantillas según el host o el rol del agente
+# ---------------------------------------------------------------------------
+# Mantener los pares archivo/nombre en el mismo orden. Separar los archivos con
+# comas y los nombres con barras verticales.
+# Usar LOCAL_TEMPLATE_* para el host local y ROLE_*_TEMPLATE_* para cada rol.
+# ---------------------------------------------------------------------------
+# Guardar los ID importados para reutilizarlos durante esta ejecución
+# ---------------------------------------------------------------------------
+declare -A IMPORTED_IDS=()
+_TPL_ID=""
+TPL_JSON="[]"
+
+import_template() {
+  local _file="$1" _name="$2" _id _req _res _err
+
+  # -------------------------------------------------------------------------
+  # Reutilizar el ID de una plantilla ya importada en esta ejecución
+  # -------------------------------------------------------------------------
+  if [ -n "${IMPORTED_IDS[$_file]:-}" ]; then
+    _TPL_ID="${IMPORTED_IDS[$_file]}"
+    return 0
+  fi
+
+  if [ ! -f "$_file" ]; then
+    echo -e "❌ ERROR: no existe el archivo de plantilla: ${BLUE}${_file}${NC}"
+    exit 1
+  fi
+
+  echo -e "📋 Importando/actualizando: ${ORANGE}${_name}${NC}  (${_file})"
+
+  _req=$(jq -n --arg source "$(cat "$_file")" \
+      '{
+          jsonrpc: "2.0",
+          method: "configuration.import",
+          params: {
+              format: "yaml",
+              rules: {
+                  template_groups: { createMissing: true, updateExisting: true },
+                  templates:       { createMissing: true, updateExisting: true },
+                  items:           { createMissing: true, updateExisting: true },
+                  triggers:        { createMissing: true, updateExisting: true },
+                  graphs:          { createMissing: true, updateExisting: true },
+                  discoveryRules:  { createMissing: true, updateExisting: true },
+                  valueMaps:       { createMissing: true, updateExisting: true },
+                  templateDashboards: { createMissing: true, updateExisting: true }
+              },
+              source: $source
+          },
+          id: 1
+      }')
+
+  _res=$(curl -sf -X POST "$API_URL" \
+      -H "Content-Type: application/json" \
+      -H "Authorization: Bearer $TOKEN" \
+      -d "$_req")
+
+  _err=$(echo "$_res" | jq -r '.error.data // .error.message // empty')
+  if [ -n "$_err" ]; then
+      echo "❌ ERROR al importar la plantilla '${_name}':"
+      echo -e "${RED}${_err}${NC}"
+      exit 1
+  fi
+
+  _id=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "$(jq -n --arg n "$_name" \
+        '{jsonrpc:"2.0",method:"template.get",params:{filter:{name:[$n]},output:["templateid"]},id:1}')" \
+    | jq -r '.result[0].templateid // empty')
+
+  if [ -z "$_id" ]; then
+      echo "❌ ERROR: no se pudo obtener el ID de la plantilla '${_name}'."
+      echo -e "   ${YELLOW}El nombre en el .env debe coincidir exactamente con el campo 'name:' de ${BLUE}${_file}${NC}"
+      exit 1
+  fi
+
+  echo "   - ✅ '${_name}' lista, ID ${_id}"
+  IMPORTED_IDS[$_file]="$_id"
+  _TPL_ID="$_id"
+}
+# ---------------------------------------------------------------------------
+# Buscar una plantilla existente de Zabbix sin importar un archivo
+# ---------------------------------------------------------------------------
+lookup_template() {
+  local _name="$1" _id
+  echo -e "📋 Plantilla existente de Zabbix: ${ORANGE}${_name}${NC}"
+
+  _id=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "$(jq -n --arg n "$_name" \
+        '{jsonrpc:"2.0",method:"template.get",params:{filter:{name:[$n]},output:["templateid"]},id:1}')" \
+    | jq -r '.result[0].templateid // empty')
+
+  if [ -z "$_id" ]; then
+      echo "❌ ERROR: Zabbix no tiene una plantilla llamada '${_name}'."
+      echo -e "   ${YELLOW}Copiar el nombre exacto desde Data collection → Templates${NC}"
+      exit 1
+  fi
+
+  echo "   - ✅ '${_name}' lista, ID ${_id}"
+  _TPL_ID="$_id"
+}
+
+# ---------------------------------------------------------------------------
+# Resolver los pares archivo/nombre y armar el arreglo JSON de ID
+# ---------------------------------------------------------------------------
+resolve_templates() {
+  local _files="$1" _names="$2" _label="$3" _ids="" _i
+  local -a _tpl_files _tpl_names
+
+  if [ -z "$_files" ] || [ -z "$_names" ]; then
+    TPL_JSON="[]"
+    return 0
+  fi
+
+  IFS=',' read -r -a _tpl_files <<< "$_files"
+  IFS='|' read -r -a _tpl_names <<< "$_names"
+
+  if [ "${#_tpl_files[@]}" -ne "${#_tpl_names[@]}" ]; then
+    echo "❌ ERROR (${_label}): hay ${#_tpl_files[@]} archivos y ${#_tpl_names[@]} nombres."
+    echo -e "   ${YELLOW}Separar los archivos con comas y los nombres con barras verticales, en el mismo orden.${NC}"
+    exit 1
+  fi
+
+  for _i in "${!_tpl_files[@]}"; do
+    if [ "$(trim "${_tpl_files[$_i]}")" = "-" ]; then
+      lookup_template "$(trim "${_tpl_names[$_i]}")"
+    else
+      import_template "/templates/$(trim "${_tpl_files[$_i]}")" "$(trim "${_tpl_names[$_i]}")"
+    fi
+    _ids="${_ids}${_ids:+ }${_TPL_ID}"
+  done
+
+  TPL_JSON=$(printf '%s\n' $_ids | jq -R '{templateid: .}' | jq -s -c '.')
+  echo "   - 📋 Plantillas para ${_label}: $TPL_JSON"
+}
+
+# ---------------------------------------------------------------------------
+# Resolver las plantillas que se vinculan al host local
+# ---------------------------------------------------------------------------
+resolve_templates "${LOCAL_TEMPLATE_FILES:-}" "${LOCAL_TEMPLATE_NAMES:-}" "host local"
+LOCAL_TEMPLATE_JSON="$TPL_JSON"
+
+if [ "$LOCAL_TEMPLATE_JSON" = "[]" ]; then
+  echo "⚠️  No se indicaron plantillas para el host local; se usa ICMP Ping."
+  _icmp=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d '{"jsonrpc":"2.0","method":"template.get","params":{"filter":{"name":["ICMP Ping"]},"output":["templateid"]},"id":1}' \
+    | jq -r '.result[0].templateid // empty')
+  LOCAL_TEMPLATE_JSON=$(jq -n -c --arg id "$_icmp" '[{templateid: $id}]')
+fi
+
+# ---------------------------------------------------------------------------
+# Resolver las plantillas de los roles remotos para el autorregistro
+# ---------------------------------------------------------------------------
+resolve_templates "${ROLE_DATABUS_TEMPLATE_FILES:-}" "${ROLE_DATABUS_TEMPLATE_NAMES:-}" "rol databus"
+DATABUS_TEMPLATE_JSON="$TPL_JSON"
+resolve_templates "${ROLE_INFOBUS_TEMPLATE_FILES:-}" "${ROLE_INFOBUS_TEMPLATE_NAMES:-}" "rol infobus"
+INFOBUS_TEMPLATE_JSON="$TPL_JSON"
+
+# ---------------------------------------------------------------------------
+# Buscar el agente local y crear o actualizar su configuración
+# ---------------------------------------------------------------------------
+# ---------------------------------------------------------------------------
+# Revisar si el host local ya existe en Zabbix
+# ---------------------------------------------------------------------------
+HOST_ID=$(curl -sf -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -H "Authorization: Bearer $TOKEN" \
+  -d "{\"jsonrpc\":\"2.0\",\"method\":\"host.get\",\"params\":{\"filter\":{\"host\":[\"$LOCAL_HOST_NAME\"]}},\"id\":5}" \
+  | grep -o '"hostid":"[^"]*"' | head -1 | cut -d'"' -f4)
+
+# ---------------------------------------------------------------------------
+# Actualizar la interfaz y las plantillas si el host ya existe
+# ---------------------------------------------------------------------------
+if [ -n "$HOST_ID" ]; then
+    echo "🔄 El host ya existe (ID: $HOST_ID), actualizando la interfaz..."
+
+  # -------------------------------------------------------------------------
+  # Obtener la interfaz actual del host
+  # -------------------------------------------------------------------------
+  IFACE_ID=$(curl -sf -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"hostinterface.get\",\"params\":{\"hostids\":\"$HOST_ID\"},\"id\":6}" \
+    | grep -o '"interfaceid":"[^"]*"' | head -1 | cut -d'"' -f4)
+
+  # -------------------------------------------------------------------------
+  # Verificar que se encontró una interfaz
+  # -------------------------------------------------------------------------
+  if [ -z "$IFACE_ID" ]; then
+    echo "❌ No se encontró ninguna interfaz para el host $HOST_ID, saliendo..."
+    exit 1
+  fi
+
+  # -------------------------------------------------------------------------
+  # Actualizar la interfaz para usar el nombre DNS configurado
+  # -------------------------------------------------------------------------
+  curl -sf -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"hostinterface.update\",\"params\":{\"interfaceid\":\"$IFACE_ID\",\"type\":1,\"useip\":0,\"dns\":\"$HOST_DNS\",\"ip\":\"\",\"port\":\"$HOST_PORT\",\"main\":1},\"id\":7}" > /dev/null
+  echo "   - ✅ Interfaz actualizada al DNS: $HOST_DNS:$HOST_PORT"
+  # -------------------------------------------------------------------------
+  # Aplicar las plantillas deseadas y limpiar las que se quitaron
+  # -------------------------------------------------------------------------
+  _linked=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"host.get\",\"params\":{\"hostids\":\"$HOST_ID\",\"selectParentTemplates\":[\"templateid\"],\"output\":[\"hostid\"]},\"id\":9}" \
+    | jq -c '[.result[0].parentTemplates[]? | {templateid}]')
+  _clear=$(jq -n -c --argjson have "$_linked" --argjson want "$LOCAL_TEMPLATE_JSON" '$have - $want')
+
+  curl -sf -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"host.update\",\"params\":{\"hostid\":\"$HOST_ID\",\"templates\":$LOCAL_TEMPLATE_JSON,\"templates_clear\":$_clear},\"id\":9}" > /dev/null
+  echo "   - ✅ Plantillas vinculadas de nuevo: $LOCAL_TEMPLATE_JSON"
+  [ "$_clear" != "[]" ] && echo "   - 🧹 Plantillas desvinculadas y limpiadas: $_clear"
+else
+
+  # -------------------------------------------------------------------------
+  # Crear el host con su interfaz, grupo y plantillas si no existe
+  # -------------------------------------------------------------------------
+  echo "➕ Creando el host: $LOCAL_HOST_NAME"
+  curl -sf -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"host.create\",\"params\":{\"host\":\"$LOCAL_HOST_NAME\",\"interfaces\":[{\"type\":1,\"main\":1,\"useip\":0,\"ip\":\"\",\"dns\":\"$HOST_DNS\",\"port\":\"$HOST_PORT\"}],\"groups\":[{\"groupid\":\"$GROUP_ID\"}],\"templates\":$LOCAL_TEMPLATE_JSON},\"id\":8}" > /dev/null
+  echo "✅ Host creado con DNS: $HOST_DNS:$HOST_PORT"
+fi
+# ---------------------------------------------------------------------------
+# Borrar el host por defecto "Zabbix server"
+# ---------------------------------------------------------------------------
+DEFAULT_HOST_ID=$(curl -sf -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -H "Authorization: Bearer $TOKEN" \
+  -d "{\"jsonrpc\":\"2.0\",\"method\":\"host.get\",\"params\":{\"filter\":{\"host\":[\"Zabbix server\"]}},\"id\":5}" \
+  | grep -o '"hostid":"[^"]*"' | head -1 | cut -d'"' -f4)
+
+curl -sf -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"host.delete\",\"params\":[\"$DEFAULT_HOST_ID\"],\"id\":7}"
+
+# ---------------------------------------------------------------------------
+# Preparar una acción de autorregistro separada para cada rol de agente remoto
+# ---------------------------------------------------------------------------
+# Exigir que coincidan los metadatos comunes y el rol declarado en ZBX_METADATA,
+# para que el host local no coincida con las acciones de los agentes remotos.
+# ---------------------------------------------------------------------------
+
+GROUP_ADD_ID=$(curl -s -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -H "Authorization: Bearer $TOKEN" \
+  -d "{\"jsonrpc\":\"2.0\",\"method\":\"hostgroup.get\",\"params\":{\"filter\":{\"name\":[\"$HOST_GROUP\"]},\"output\":[\"groupid\"]},\"id\":1}" \
+  | jq -r '.result[0].groupid // empty')
+
+GROUP_REMOVE_ID=$(curl -s -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -H "Authorization: Bearer $TOKEN" \
+  -d '{"jsonrpc":"2.0","method":"hostgroup.get","params":{"filter":{"name":["Discovered hosts"]},"output":["groupid"]},"id":1}' \
+  | jq -r '.result[0].groupid // empty')
+
+echo "   - 📁 Grupo a agregar: $GROUP_ADD_ID"
+echo "   - 📁 Grupo a quitar : $GROUP_REMOVE_ID"
+
+# ---------------------------------------------------------------------------
+# Quitar la acción anterior que aplicaba las mismas plantillas a todos los agentes
+# ---------------------------------------------------------------------------
+LEGACY_ACTION_ID=$(curl -s -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -H "Authorization: Bearer $TOKEN" \
+  -d '{"jsonrpc":"2.0","method":"action.get","params":{"filter":{"name":["Self-registration-agents-simovilab"]},"output":["actionid"]},"id":1}' \
+  | jq -r '.result[0].actionid // empty')
+
+if [ -n "$LEGACY_ACTION_ID" ]; then
+  curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"action.delete\",\"params\":[\"$LEGACY_ACTION_ID\"],\"id\":1}" > /dev/null
+  echo "   - 🗑️  Se borró la acción anterior 'Self-registration-agents-simovilab'"
+fi
+
+# ---------------------------------------------------------------------------
+# Crear o actualizar la acción de autorregistro de un rol
+# ---------------------------------------------------------------------------
+upsert_role_action() {
+  local _role="$1" _tpl_json="$2" _name="Self-registration-simovilab-$1" _action_id _body
+
+  if [ "$_tpl_json" = "[]" ]; then
+    echo "⚠️  El rol '${_role}' no tiene plantillas en el .env; no se crea su acción de autorregistro."
+    return 0
+  fi
+
+  _body=$(jq -n -c \
+    --arg meta "$ZBX_METADATA" --arg role "$_role" \
+    --arg gadd "$GROUP_ADD_ID" --arg grem "$GROUP_REMOVE_ID" \
+    --argjson tpl "$_tpl_json" \
+    '{filter:{evaltype:1,conditions:[
+        {conditiontype:24,operator:2,value:$meta},
+        {conditiontype:24,operator:2,value:$role}]},
+      operations:[
+        {operationtype:2},
+        {operationtype:4,opgroup:[{groupid:$gadd}]},
+        {operationtype:5,opgroup:[{groupid:$grem}]},
+        {operationtype:6,optemplate:$tpl}]}')
+
+  _action_id=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "$(jq -n -c --arg n "$_name" '{jsonrpc:"2.0",method:"action.get",params:{filter:{name:[$n]},output:["actionid"]},id:1}')" \
+    | jq -r '.result[0].actionid // empty')
+
+  if [ -z "$_action_id" ]; then
+    curl -s -X POST "$API_URL" \
+      -H "Content-Type: application/json" \
+      -H "Authorization: Bearer $TOKEN" \
+      -d "$(jq -n -c --arg n "$_name" --argjson b "$_body" '{jsonrpc:"2.0",method:"action.create",params:({name:$n,eventsource:2,status:0}+$b),id:1}')" > /dev/null
+    echo "   - ✅ Acción '${_name}' creada: $_tpl_json"
+  else
+    # -----------------------------------------------------------------------
+    # Actualizar la acción para aplicar los últimos cambios del .env
+    # -----------------------------------------------------------------------
+    curl -s -X POST "$API_URL" \
+      -H "Content-Type: application/json" \
+      -H "Authorization: Bearer $TOKEN" \
+      -d "$(jq -n -c --arg id "$_action_id" --argjson b "$_body" '{jsonrpc:"2.0",method:"action.update",params:({actionid:$id}+$b),id:1}')" > /dev/null
+    echo "   - 🔄 Acción '${_name}' actualizada: $_tpl_json"
+  fi
+}
+
+echo "ℹ️  Configurando las acciones de autorregistro de los agentes remotos"
+upsert_role_action databus "$DATABUS_TEMPLATE_JSON"
+upsert_role_action infobus "$INFOBUS_TEMPLATE_JSON"
+
+# ---------------------------------------------------------------------------
+# Configurar la autenticación PSK para el autorregistro
+# ---------------------------------------------------------------------------
+curl -s -X POST "$API_URL" \
+  -H "Content-Type: application/json" \
+  -H "Authorization: Bearer $TOKEN" \
+  -d "{\"jsonrpc\":\"2.0\",\"method\":\"autoregistration.update\",\"params\":{\"tls_accept\":2,\"tls_psk_identity\":\"$ZBX_TLSPSKIDENTITY\",\"tls_psk\":\"$PSK_VALUE\"},\"id\":1}" > /dev/null
+echo "   - 🔑 El autorregistro usará autenticación TLS PSK"
+
+# ---------------------------------------------------------------------------
+# Crear o actualizar el dashboard global (nombre por defecto: simovilab)
+# ---------------------------------------------------------------------------
+# Los dashboards globales no forman parte de ninguna plantilla, así que este
+# bloque arma el dashboard a partir de nombres (hosts, llaves de ítems, grupo de
+# hosts). Los ID internos cambian entre instalaciones, por eso se buscan en cada
+# ejecución.
+# Este bloque es la fuente de verdad: los cambios hechos a este dashboard en la
+# interfaz web se sobrescriben la próxima vez que corre zabbix-init. Editar este
+# bloque en su lugar.
+# Los hosts remotos existen solo después de que su agente se autorregistra.
+# Mientras tanto sus paneles se omiten, y la siguiente ejecución de zabbix-init
+# los agrega.
+# ---------------------------------------------------------------------------
+DASHBOARD_NAME="${DASHBOARD_NAME:-simovilab}"
+
+api_call() {
+  curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "$1"
+}
+
+host_id_by_name() {
+  api_call "$(jq -n -c --arg h "$1" \
+    '{jsonrpc:"2.0",method:"host.get",params:{filter:{host:[$h]},output:["hostid"]},id:1}')" \
+    | jq -r '.result[0].hostid // empty'
+}
+
+item_id_by_key() {
+  if [ -z "$1" ]; then return 0; fi
+  api_call "$(jq -n -c --arg h "$1" --arg k "$2" \
+    '{jsonrpc:"2.0",method:"item.get",params:{hostids:[$h],filter:{key_:[$k]},output:["itemid"]},id:1}')" \
+    | jq -r '.result[0].itemid // empty'
+}
+
+echo -e "📊 Preparando el dashboard global: ${ORANGE}${DASHBOARD_NAME}${NC}"
+
+DASH_LOCAL_ID=$(host_id_by_name "$LOCAL_HOST_NAME")
+DASH_DB_ID=$(host_id_by_name "${MACDT_HOST_DATABUS:-Databus-host}")
+DASH_IB_ID=$(host_id_by_name "${MACDT_HOST_INFOBUS:-Infobus-host}")
+DASH_DB_PING=$(item_id_by_key "$DASH_DB_ID" 'icmpping[,3]')
+DASH_IB_PING=$(item_id_by_key "$DASH_IB_ID" 'icmpping[,3]')
+
+[ -z "$DASH_LOCAL_ID" ] && echo "   - ⚠️  No se encontró el host '$LOCAL_HOST_NAME'; se omite su panel"
+[ -z "$DASH_DB_ID" ]    && echo "   - ⚠️  El host '${MACDT_HOST_DATABUS:-Databus-host}' aún no se registra; se omiten sus paneles"
+[ -z "$DASH_IB_ID" ]    && echo "   - ⚠️  El host '${MACDT_HOST_INFOBUS:-Infobus-host}' aún no se registra; se omiten sus paneles"
+
+# ---------------------------------------------------------------------------
+# Armar los widgets. Cuadrícula de 72 columnas de ancho.
+#   y 0-3  : tarjeta srv-gestión | System Information | reloj
+#   y 4-7  : tarjeta srv-infobús | ping databus | ping infobus
+#                                | Alertas (problemas de HOST_GROUP, y 6-11)
+#   y 8-11 : tarjeta srv-databús |
+# Secciones de la tarjeta de host: 0 grupos, 1 descripción, 2 monitoreo,
+# 3 disponibilidad, 4 monitoreado por, 5 plantillas, 6 inventario, 7 etiquetas.
+# La lista define su orden.
+# Paneles de ping: rojo cuando el valor es 0 (sin respuesta), verde cuando es 1.
+# ---------------------------------------------------------------------------
+DASH_WIDGETS=$(jq -n -c \
+  --arg local "$DASH_LOCAL_ID" --arg db "$DASH_DB_ID" --arg ib "$DASH_IB_ID" \
+  --arg dbping "$DASH_DB_PING" --arg ibping "$DASH_IB_PING" --arg gid "$GROUP_ID" '
+  def sections($order): [$order | to_entries[] | {type:0, name:"sections.\(.key)", value:(.value|tostring)}];
+  def hostcard($name; $hid; $y; $order; $suppressed):
+    if $hid == "" then empty else
+      {type:"hostcard", name:$name, x:0, y:$y, width:36, height:4, view_mode:0,
+       fields:([{type:3, name:"hostid.0", value:$hid}]
+               + (if $suppressed then [{type:0, name:"show_suppressed", value:"1"}] else [] end)
+               + sections($order))}
+    end;
+  def ping($name; $iid; $x; $w; $bold):
+    if $iid == "" then empty else
+      {type:"item", name:$name, x:$x, y:4, width:$w, height:2, view_mode:0,
+       fields:([{type:4, name:"itemid.0", value:$iid}]
+               + (if $bold then [{type:0, name:"desc_bold", value:"1"}] else [] end)
+               + [{type:0, name:"decimal_places", value:"0"},
+                  {type:1, name:"thresholds.0.color", value:"E65660"},
+                  {type:1, name:"thresholds.0.threshold", value:"0"},
+                  {type:1, name:"thresholds.1.color", value:"81C784"},
+                  {type:1, name:"thresholds.1.threshold", value:"1"}])}
+    end;
+  [ hostcard("srv-gestión"; $local; 0; [2,3,4,0,1,5,6,7]; false),
+    hostcard("srv-infobús"; $ib;    4; [2,3,4,0,5,1,6,7]; true),
+    hostcard("srv-databús"; $db;    8; [2,3,4,0,5,1,6,7]; true),
+    {type:"clock", name:"Reloj", x:58, y:0, width:14, height:4, view_mode:1,
+     fields:[{type:0, name:"clock_type",   value:"1"},
+             {type:0, name:"show.0",       value:"1"},
+             {type:0, name:"show.1",       value:"2"},
+             {type:0, name:"show.2",       value:"3"},
+             {type:1, name:"bg_color",     value:"002620"},
+             {type:1, name:"date_color",   value:"FFFFFF"},
+             {type:0, name:"time_bold",    value:"1"},
+             {type:1, name:"time_color",   value:"FFFFFF"},
+             {type:0, name:"time_format",  value:"1"},
+             {type:1, name:"tzone_color",  value:"FFFFFF"},
+             {type:0, name:"tzone_format", value:"1"}]},
+    {type:"problems", name:"Alertas", x:36, y:6, width:36, height:6, view_mode:0,
+     fields:[{type:2, name:"groupids.0", value:$gid},
+             {type:0, name:"show_tags",  value:"3"},
+             {type:1, name:"reference",  value:"EHSNB"}]},
+    {type:"systeminfo", name:"System Information", x:36, y:0, width:22, height:4, view_mode:0, fields:[]},
+    ping("srv-databus"; $dbping; 36; 11; false),
+    ping("srv-infobus"; $ibping; 48; 10; true)
+  ]')
+
+# ---------------------------------------------------------------------------
+# Crear el dashboard, o reemplazar su contenido si ya existe
+# ---------------------------------------------------------------------------
+DASH_ID=$(api_call "$(jq -n -c --arg n "$DASHBOARD_NAME" \
+  '{jsonrpc:"2.0",method:"dashboard.get",params:{filter:{name:[$n]},output:["dashboardid"]},id:1}')" \
+  | jq -r '.result[0].dashboardid // empty')
+
+if [ -z "$DASH_ID" ]; then
+  _res=$(api_call "$(jq -n -c --arg n "$DASHBOARD_NAME" --argjson w "$DASH_WIDGETS" \
+    '{jsonrpc:"2.0",method:"dashboard.create",params:{name:$n,display_period:600,auto_start:1,private:1,pages:[{widgets:$w}]},id:1}')")
+  _action="crear"
+else
+  _res=$(api_call "$(jq -n -c --arg id "$DASH_ID" --argjson w "$DASH_WIDGETS" \
+    '{jsonrpc:"2.0",method:"dashboard.update",params:{dashboardid:$id,display_period:600,auto_start:1,pages:[{widgets:$w}]},id:1}')")
+  _action="actualizar"
+fi
+
+_err=$(echo "$_res" | jq -r '.error.data // .error.message // empty')
+if [ -n "$_err" ]; then
+  echo -e "   - ⚠️  No se pudo ${_action} el dashboard '${DASHBOARD_NAME}': ${RED}${_err}${NC}"
+else
+  echo "   - ✅ Dashboard '${DASHBOARD_NAME}' listo (acción: ${_action}) con $(echo "$DASH_WIDGETS" | jq length) paneles"
+fi
+
+# ---------------------------------------------------------------------------
+# Crear el usuario web y quitar la cuenta por defecto cuando corresponda
+# ---------------------------------------------------------------------------
+if [ "$flag_new_user" = "TRUE" ]; then
+  echo "ℹ️  Creando el usuario nuevo '$API_WEB_USER' y quitando la cuenta por defecto"
+  echo "🔍 Buscando el rol Super Admin..."
+  ROLE_ID=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d '{"jsonrpc":"2.0","method":"role.get","params":{"filter":{"name":["Super admin role"]},"output":["roleid"]},"id":1}' \
+    | grep -o '"roleid":"[^"]*"' | head -1 | cut -d'"' -f4)
+  
+  # -------------------------------------------------------------------------
+  # Verificar que se encontró el rol de superadministrador
+  # -------------------------------------------------------------------------
+  if [ -z "$ROLE_ID" ]; then
+    echo "❌ No se encontró el rol Super Admin, saliendo..."
+    exit 1
+  fi
+  echo "   - 👑 ID del rol: $ROLE_ID"
+
+  # -------------------------------------------------------------------------
+  # Obtener el ID del grupo Zabbix administrators
+  # -------------------------------------------------------------------------
+  echo "🔍 Buscando el ID del grupo 'Zabbix administrators'..."
+  USERGROUP_ID_0=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d '{"jsonrpc":"2.0","method":"usergroup.get","params":{"filter":{"name":["Zabbix administrators"]},"output":["usrgrpid"]},"id":1}' \
+    | grep -o '"usrgrpid":"[^"]*"' | head -1 | cut -d'"' -f4)
+
+  # -------------------------------------------------------------------------
+  # Verificar que se encontró el grupo de administradores
+  # -------------------------------------------------------------------------
+  if [ -z "$USERGROUP_ID_0" ]; then
+    echo "❌ No se encontró el grupo 'Zabbix administrators', saliendo..."
+    exit 1
+  fi
+  echo "   - 👥 ID del grupo 'Zabbix administrators': $USERGROUP_ID_0"
+
+  # -------------------------------------------------------------------------
+  # Obtener el ID del grupo Internal
+  # -------------------------------------------------------------------------
+  echo "🔍 Buscando el ID del grupo 'Internal'..."
+  USERGROUP_ID_1=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d '{"jsonrpc":"2.0","method":"usergroup.get","params":{"filter":{"name":["Internal"]},"output":["usrgrpid"]},"id":1}' \
+    | grep -o '"usrgrpid":"[^"]*"' | head -1 | cut -d'"' -f4)
+
+  # -------------------------------------------------------------------------
+  # Verificar que se encontró el grupo Internal
+  # -------------------------------------------------------------------------
+  if [ -z "$USERGROUP_ID_1" ]; then
+    echo "❌ No se encontró el grupo 'Internal', saliendo..."
+    exit 1
+  fi
+  echo "   - 👥 ID del grupo 'Internal': $USERGROUP_ID_1"
+
+  # -------------------------------------------------------------------------
+  # Revisar si el usuario configurado ya existe
+  # -------------------------------------------------------------------------
+  NEW_USER_ID=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"user.get\",\"params\":{\"filter\":{\"username\":[\"$API_WEB_USER\"]},\"output\":[\"userid\"]},\"id\":1}" \
+    | grep -o '"userid":"[^"]*"' | head -1 | cut -d'"' -f4)
+
+  # -------------------------------------------------------------------------
+  # Omitir la creación si el usuario ya existe
+  # -------------------------------------------------------------------------
+  if [ -n "$NEW_USER_ID" ]; then
+    echo "ℹ️  El usuario '$API_WEB_USER' ya existe"
+  else
+    # -----------------------------------------------------------------------
+    # Crear el usuario si todavía no existe
+    # -----------------------------------------------------------------------
+    echo "➕ Creando el usuario: $API_WEB_USER..."
+    NEW_USER_ID=$(curl -s -X POST "$API_URL" \
+      -H "Content-Type: application/json" \
+      -H "Authorization: Bearer $TOKEN" \
+      -d "{\"jsonrpc\":\"2.0\",\"method\":\"user.create\",\"params\":{\"username\":\"$API_WEB_USER\",\"passwd\":\"$API_WEB_PASS\",\"roleid\":\"$ROLE_ID\",\"usrgrps\":[{\"usrgrpid\":\"$USERGROUP_ID_0\"},{\"usrgrpid\":\"$USERGROUP_ID_1\"}],\"name\":\"$API_WEB_USER\",\"autologin\":0,\"autologout\":\"0\"},\"id\":1}" \
+      | grep -o '"userids":\["[^"]*"' | cut -d'"' -f4)
+
+    # -----------------------------------------------------------------------
+    # Verificar que la creación del usuario devolvió su ID
+    # -----------------------------------------------------------------------
+    if [ -z "$NEW_USER_ID" ]; then
+      echo "❌ Falló la creación del usuario $API_WEB_USER; la cuenta por defecto NO se borra..."
+      echo "🛡️  Verificar que la contraseña del .env cumpla las políticas de seguridad de Zabbix:"
+      echo "   - 🔐 Requisitos de la contraseña:"
+      echo "      - al menos 8 caracteres"
+      echo "      - no contener el nombre, el apellido ni el usuario"
+      echo "      - no ser una contraseña común ni relacionada con el contexto"
+      exit 1
+    fi
+    echo "   - ✅ Usuario $API_WEB_USER creado con ID: $NEW_USER_ID"
+  fi
+
+  # -------------------------------------------------------------------------
+  # Autenticarse con el usuario nuevo antes de quitar la cuenta por defecto
+  # -------------------------------------------------------------------------
+  echo "   - 🔑 Autenticando con el usuario nuevo..."
+  NEW_TOKEN=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"user.login\",\"params\":{\"username\":\"$API_WEB_USER\",\"password\":\"$API_WEB_PASS\"},\"id\":1}" \
+    | grep -o '"result":"[^"]*"' | cut -d'"' -f4)
+
+  # -------------------------------------------------------------------------
+  # Verificar que la autenticación con el usuario nuevo funcionó
+  # -------------------------------------------------------------------------
+  if [ -z "$NEW_TOKEN" ]; then
+    echo "⚠️  No se pudo autenticar con el usuario nuevo, saliendo..."
+    exit 1
+  fi
+
+  echo "   - 🔑 Token del usuario nuevo obtenido"
+  echo "ℹ️  Se procede a borrar la cuenta por defecto"
+
+  # -------------------------------------------------------------------------
+  # Buscar la cuenta de administrador por defecto
+  # -------------------------------------------------------------------------
+  echo "🔍 Buscando el usuario Admin..."
+  ADMIN_ID=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $NEW_TOKEN" \
+    -d '{"jsonrpc":"2.0","method":"user.get","params":{"filter":{"username":["Admin"]},"output":["userid"]},"id":1}' \
+    | grep -o '"userid":"[^"]*"' | head -1 | cut -d'"' -f4)
+
+  # -------------------------------------------------------------------------
+  # Omitir el borrado si la cuenta por defecto ya no existe
+  # -------------------------------------------------------------------------
+  if [ -z "$ADMIN_ID" ]; then
+    echo "⚠️  No se encontró el usuario Admin (puede que ya se haya borrado), saliendo..."
+    exit 0
+  fi
+  echo "   - 🔍 ID de Admin: $ADMIN_ID"
+
+  # -------------------------------------------------------------------------
+  # Traspasar los mapas de la cuenta por defecto al usuario nuevo
+  # -------------------------------------------------------------------------
+  echo "🗺️  Traspasando los mapas de 'Admin' al usuario nuevo '$API_WEB_USER'..."
+  MAPS=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $NEW_TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"map.get\",\"params\":{\"filter\":{\"userid\":[\"$ADMIN_ID\"]},\"output\":[\"sysmapid\"]},\"id\":1}" \
+    | grep -o '"sysmapid":"[^"]*"' | cut -d'"' -f4)
+
+  for MAP_ID in $MAPS; do
+    curl -s -X POST "$API_URL" \
+      -H "Content-Type: application/json" \
+      -H "Authorization: Bearer $NEW_TOKEN" \
+      -d "{\"jsonrpc\":\"2.0\",\"method\":\"map.update\",\"params\":{\"sysmapid\":\"$MAP_ID\",\"userid\":\"$NEW_USER_ID\"},\"id\":1}" > /dev/null
+    echo "   - 🗺️  Mapa '$MAP_ID' traspasado"
+  done
+
+  # -------------------------------------------------------------------------
+  # Traspasar los dashboards de la cuenta por defecto al usuario nuevo
+  # -------------------------------------------------------------------------
+  echo "📊  Traspasando los dashboards de Admin al usuario nuevo '$API_WEB_USER'..."
+  DASHBOARDS=$(curl -s -X POST "$API_URL" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer $NEW_TOKEN" \
+    -d "{\"jsonrpc\":\"2.0\",\"method\":\"dashboard.get\",\"params\":{\"filter\":{\"userid\":[\"$ADMIN_ID\"]},\"output\":[\"dashboardid\"]},\"id\":1}" \
+    | grep -o '"dashboardid":"[^"]*"' | cut -d'"' -f4)
+
+  for DASH_ID in $DASHBOARDS; do
